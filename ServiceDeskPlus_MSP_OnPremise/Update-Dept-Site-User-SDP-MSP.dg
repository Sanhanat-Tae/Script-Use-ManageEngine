// GET UDF fields → PUT update user department/site

// Extract core identifiers
requester_id = requestObj.get("requester").get("id");
helpdesk_id  = context.get("instance").get("id");

// Extract UDF selections with safe chaining
udf          = requestObj.get("udf_fields");
dept_name    = udf.get("udf_pick_602").get("name");
site_name    = udf.get("udf_pick_603").get("name");

// Guard: skip if both values are empty
if (isNull(dept_name) && isNull(site_name))
{
    info "No UDF values provided — skipping update.";
    return "";
}

// Build payload
input_data = {
    "users": {
        "department": {
            "name": dept_name,
            "site": {
                "name": site_name
            }
        }
    }
};

// PUT request to update user
response = invokeurl
[
    url  : "http://localhost:8081/api/v3/users/" + requester_id
    type : PUT
    parameters : {
        "input_data"    : input_data,
        "TECHNICIAN_KEY": "BC020554-2CEE-41D6-A89F-541B6F4B0638",
        "PORTALID"      : helpdesk_id
    }
];

// Debug logs
info "dept_name  : " + dept_name;
info "site_name  : " + site_name;
info "response   : " + response;

return "";